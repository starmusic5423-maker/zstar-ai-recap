# ==========================================
# Production & Vercel Environment Variables
# ==========================================

# GEMINI_API_KEY: Required for Gemini API, Script Analysis, and Video Recap.
# In Vercel: Set under Project Settings -> Environment Variables -> GEMINI_API_KEY
# In AI Studio: Automatically injected from user secrets.
GEMINI_API_KEY="your_gemini_api_key_here"
VITE_GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The base domain/URL where the app is hosted (e.g., https://your-app.vercel.app).
# Optional for Vercel (automatically defaults to relative API routes).
APP_URL="http://localhost:3000"

# NODE_ENV: Set to 'production' on Vercel deployment.
NODE_ENV="production"
